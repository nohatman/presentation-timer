# cdether-bridge config. Copy to .env and run:  node --env-file=.env bridge.js
# Every value can also be a CLI flag, e.g. --server / --token / --interface.

# --- required ---
SERVER_URL=https://your-presentation-timer.example.com
DISPLAY_TOKEN=paste-the-rooms-DISPLAY-token-here

# --- CDEther destination: pick ONE (required unless DRY_RUN=true) ---
# Preferred: the adapter NAME. The directed broadcast address AND the UDP bind
# address are both derived from it, so broadcasts leave the right NIC on a
# multi-homed PC. List names with:  node bridge.js --list-adapters
CDETHER_INTERFACE=Ethernet
# Or an explicit directed-broadcast address (the rig used 192.168.8.255). If it
# matches a known adapter the socket still binds to it; otherwise it is unbound.
# BROADCAST_ADDRESS=192.168.8.255

# --- optional ---
CDETHER_PORT=36700
FRAME_INTERVAL_MS=1000

# stopped/idle room: "duration" = show the armed time in green (matches
# display.html), "off" = send OFF while idle.
IDLE_BEHAVIOUR=duration

# true = compute + log frames only, open no UDP socket.
DRY_RUN=false

LOG_LEVEL=info
